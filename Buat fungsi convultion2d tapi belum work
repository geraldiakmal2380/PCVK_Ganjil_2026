      "cell_type": "code",
      "source": [
        "def convolution2d(image, kernel, stride, padding):\n",
        "  '''\n",
        "  Image itu adalah gambar yang kita load di awal tadi\n",
        "  kernel itu matriks filter 3x3. Isinya angka tertentu yang bisa membuat gambar menjadi Tajam atau malah tambah buram\n",
        "  Stride itu batas pixel yang akan dilewati\n",
        "  padding itu batas pixel\n",
        "  '''\n",
        "  if padding > 0:\n",
        "      image_padded = np.pad(image, padding, mode='constant', constant_values=0)\n",
        "  else:\n",
        "    image_padded = image\n",
        "\n",
        "  #kedua value di bawah ini digunakan untuk menghitung batas perulangan (looping) saat proses konvlusi berjalan (ga paham tapi ok)\n",
        "  k_w, k_h = kernel.shape #ini kernel weight dan height\n",
        "  img_w, img_h = image.shape #ini img weight dan height\n",
        "\n",
        "  #Hitung dimensi matriks hasil keluaran stride\n",
        "  out_w = (img_w - k_w) // stride +1\n",
        "  out_h = (img_h - k_h) // stride +1 #simbol // artinya bagi tapi di round floor. Jika ada koma dibutlatkan ke bawah\n",
        "\n",
        "\n",
        "  #Lakukan iterasi pergeseran kernal konvulsi\n",
        "  for y in range (0,out_h):\n",
        "    for x in range (0,out_w):\n",
        "      # Ambil area piksel tetangga (region of interest) sesuai ukuran kernel (apa seh kernel iki. kernel kernel linux or smth)\n",
        "      roi = image_padded[y*stride:y*stride+k_h, x*stride:x*stride+k_w]\n",
        "      # Perkalian titik\n",
        "      output[y,x] = np.sum(roi * kernel)\n",
        "  return output\n",
        "\n"
      ],
